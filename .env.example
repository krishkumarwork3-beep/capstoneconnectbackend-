# Copy to .env and adjust. Every setting is described in app/config.py.

# PostgreSQL. psycopg 3 driver: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/capstoneconnect

# Signs sessions and reset tokens: at least 32 random characters in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with this default when COOKIE_SECURE=true.
SECRET_KEY=dev-only-change-me-dev-only-change-me
# true behind HTTPS (production); false for http://localhost.
# With true, development settings (default SECRET_KEY, DEMO_LOGIN, ALLOW_DEV_CODE) stop the API
# from starting. `uv run python -m app.check_config` lists every unsafe setting.
COOKIE_SECURE=false

# The frontend's origin(s), as a JSON list
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3100"]
# Where this API is reachable (used to build links to uploaded files)
PUBLIC_BASE_URL=http://localhost:8000

# Forgot password by SMS. "console" writes the code to the server log (development);
# "twilio" sends a real SMS.
SMS_PROVIDER=console
# Development only: also return the code to the app (shown on the forgot-password page), so the
# flow works without a phone. Anyone who knows a number could then reset that account: never on a
# public server.
ALLOW_DEV_CODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional GitHub token (a classic token with no scopes is enough): exact totals through the
# GraphQL API and a higher rate limit. Without it the public contribution calendar is read.
GITHUB_TOKEN=

# Lets the demo persona switcher sign in as a seeded student. Never in production.
DEMO_LOGIN=true

# Admin portal (../adminportal, port 3100). The first admin is created at startup from these if no
# admin has this email yet; more admins are added in the portal or with
#   uv run python -m app.admin_cli create you@example.com "Your Name"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site admin

# Throttling of sign-in, sign-up and password reset, per phone number and per IP address (shared
# by every worker through PostgreSQL). Defaults shown; all optional.
# LOGIN_LIMIT_PER_PHONE=5
# LOGIN_LIMIT_PER_IP=20
# LOGIN_WINDOW_MINUTES=15
# SIGNUP_LIMIT_PER_PHONE=5
# SIGNUP_LIMIT_PER_IP=10
# SIGNUP_WINDOW_MINUTES=60
# RESET_LIMIT_PER_PHONE=5
# RESET_LIMIT_PER_IP=20
# RESET_WINDOW_MINUTES=60
# VERIFY_LIMIT_PER_PHONE=10
# VERIFY_LIMIT_PER_IP=30
# VERIFY_WINDOW_MINUTES=15
