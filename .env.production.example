# Production settings for the API. Copy to .env.production (never commit it) or enter these in
# your host's environment settings. Every setting is described in app/config.py; after filling it
# in, `uv run python -m app.check_config` must report nothing (with APP_ENV=production the API
# refuses to start with any dangerous one).
#
# Replace example.com with your domain. The layout assumed here is the recommended one:
#   https://app.example.com    the student site (3dcapconnectfrontend)
#   https://admin.example.com  the admin portal (adminportal)
#   https://api.example.com    this API
# Other layouts (one origin through a proxy, or different sites) are in DEPLOY.md.

# --- Database --------------------------------------------------------------------------------
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE   (add ?sslmode=require for hosted databases)
DATABASE_URL=postgresql+psycopg://capstoneconnect:CHANGE_ME@db.example.com:5432/capstoneconnect
# Only for docker-compose.production.yml (its own PostgreSQL):
POSTGRES_USER=capstoneconnect
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=capstoneconnect

# --- Secrets and sessions --------------------------------------------------------------------
# 48+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out (students and admins).
SECRET_KEY=CHANGE_ME
# The issuer written into (and required of) every token. Change it to sign everyone out.
JWT_ISSUER=capstoneconnect
# Access tokens (the session cookie) live this many minutes (at most 15); the page renews them
# with the refresh cookie, which rotates on every use and lasts SESSION_DAYS at most.
ACCESS_TOKEN_MINUTES=15
REFRESH_COOKIE_NAME=cc_refresh
ADMIN_REFRESH_COOKIE_NAME=cc_admin_refresh
# AES-256-GCM keys for personal fields at rest (phones, messages, reports). "<id>:<base64 of 32
# random bytes>", comma-separated; the first one encrypts, the rest still decrypt (rotation:
# new key first, `python -m app.admin_cli rotate-keys`, then drop the old one). Generate a key:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Keep them in your secrets manager, never in the repository; losing them loses the data.
FIELD_ENCRYPTION_KEYS=k1:CHANGE_ME
# A different 32-byte key (same command) for the phone-number blind index used for log-in and
# blocked numbers. Not the same as SECRET_KEY or any field key.
BLIND_INDEX_KEY=CHANGE_ME
COOKIE_SECURE=true
# production: every unsafe setting stops the API at startup (also COOKIE_SECURE=false, SMS_PROVIDER=
# console and a SECRET_KEY under 32 characters); the API docs are off unless API_DOCS_ENABLED=true.
APP_ENV=production
# The interactive API docs (/docs, /redoc, /openapi.json) answer 404 in production unless true.
API_DOCS_ENABLED=false
# lax: site, portal and API under one domain (subdomains). none: only if they are on different
# sites (needs COOKIE_SECURE=true). See app/cookies.py.
COOKIE_SAMESITE=lax
# Empty: the cookie belongs to api.example.com only (recommended).
COOKIE_DOMAIN=
SESSION_DAYS=14
# A sign-in unused this long ends; none lasts longer than SESSION_MAX_DAYS (at most 30).
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# Per-account read budgets per 10 minutes (anti-scraping): profile views, list pages, searches,
# chat-history pages. Suspicious reading (many distinct profiles, or paging this deep) is audited
# and throttles the account's reads for READ_THROTTLE_MINUTES.
READ_LIMIT_PROFILES=300
READ_LIMIT_PAGES=200
READ_LIMIT_SEARCHES=120
READ_LIMIT_CHAT_PAGES=600
SUSPICIOUS_DISTINCT_PROFILES=80
SUSPICIOUS_LIST_DEPTH=400
READ_THROTTLE_MINUTES=15
ADMIN_SESSION_HOURS=12

# --- Where things are ------------------------------------------------------------------------
CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
# The API's public URL (links to files are built from it).
PUBLIC_BASE_URL=https://api.example.com
API_PREFIX=/api

# --- Behind a reverse proxy ------------------------------------------------------------------
# The Docker image runs uvicorn with --proxy-headers --forwarded-allow-ips "$FORWARDED_ALLOW_IPS".
# Set it to your proxy's / load balancer's address (or "*" if only the proxy can reach the API),
# so the per-IP sign-in limits see the visitor's address, not the proxy's.
FORWARDED_ALLOW_IPS=127.0.0.1
# For servers started some other way (not the image): the same rule inside the app.
TRUSTED_PROXY_IPS=
WEB_CONCURRENCY=2
PORT=8000

# --- Uploaded files --------------------------------------------------------------------------
# local: a persistent disk mounted at UPLOAD_DIR (the image uses /data/uploads).
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO): use it when the host
#     has no persistent disk or you run more than one server. Keep the bucket PRIVATE: the API
#     serves every file itself and checks who may see it.
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# --- Password reset by SMS -------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Never true in production (it returns reset codes to whoever asks).
ALLOW_DEV_CODE=false

# --- Other -----------------------------------------------------------------------------------
# A classic GitHub token with no scopes: exact contribution totals and a higher rate limit.
GITHUB_TOKEN=
# A cached contribution total older than this is refreshed when a profile is viewed.
GITHUB_REFRESH_HOURS=24
# Never true in production.
DEMO_LOGIN=false
# The first admin, created at start if missing. Prefer `python -m app.admin_cli create` and leave
# ADMIN_PASSWORD empty (an admin's password lives in the database, not here).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site admin
REPORTS_PER_DAY=10
# Sign-in/sign-up/reset limits (defaults shown in .env.example) can be tuned here too.

# --- Request limits and hosts (app/guard.py) -------------------------------------------------
# The Host names this API answers to (others get 400): your API's name.
ALLOWED_HOSTS=["api.example.com"]
MAX_JSON_BODY_BYTES=1000000
MAX_UPLOAD_BODY_BYTES=6000000
MAX_JSON_DEPTH=32
MAX_JSON_ARRAY=5000
# Live chat sockets one API process holds at most (10 per account).
WS_MAX_SOCKETS=2000
# The longest a single database statement may run, in milliseconds.
DB_STATEMENT_TIMEOUT_MS=15000
