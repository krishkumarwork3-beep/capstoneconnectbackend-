# Production settings for the API. Copy to .env.production (never commit it) or enter these in
# your host's environment settings. Every setting is described in app/config.py; after filling it
# in, `uv run python -m app.check_config` must report nothing (the API refuses to start with the
# dangerous ones when COOKIE_SECURE=true).
#
# Replace example.com with your domain. The layout assumed here is the recommended one:
#   https://app.example.com    the student site (3dcapconnectfrontend)
#   https://admin.example.com  the admin portal (adminportal)
#   https://api.example.com    this API
# Other layouts (one origin through a proxy, or different sites) are in DEPLOY.md.

# --- Database --------------------------------------------------------------------------------
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE   (add ?sslmode=require for hosted databases)
DATABASE_URL=postgresql+psycopg://capstoneconnect:CHANGE_ME@db.example.com:5432/capstoneconnect
# Only for docker-compose.production.yml (its own PostgreSQL):
POSTGRES_USER=capstoneconnect
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=capstoneconnect

# --- Secrets and sessions --------------------------------------------------------------------
# 48+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out (students and admins).
SECRET_KEY=CHANGE_ME
COOKIE_SECURE=true
# lax: site, portal and API under one domain (subdomains). none: only if they are on different
# sites (needs COOKIE_SECURE=true). See app/cookies.py.
COOKIE_SAMESITE=lax
# Empty: the cookie belongs to api.example.com only (recommended).
COOKIE_DOMAIN=
SESSION_DAYS=14
ADMIN_SESSION_HOURS=12

# --- Where things are ------------------------------------------------------------------------
CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
# The API's public URL (links to files are built from it).
PUBLIC_BASE_URL=https://api.example.com
API_PREFIX=/api

# --- Behind a reverse proxy ------------------------------------------------------------------
# The Docker image runs uvicorn with --proxy-headers --forwarded-allow-ips "$FORWARDED_ALLOW_IPS".
# Set it to your proxy's / load balancer's address (or "*" if only the proxy can reach the API),
# so the per-IP sign-in limits see the visitor's address, not the proxy's.
FORWARDED_ALLOW_IPS=127.0.0.1
# For servers started some other way (not the image): the same rule inside the app.
TRUSTED_PROXY_IPS=
WEB_CONCURRENCY=2
PORT=8000

# --- Uploaded files --------------------------------------------------------------------------
# local: a persistent disk mounted at UPLOAD_DIR (the image uses /data/uploads).
# s3: any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO): use it when the host
#     has no persistent disk or you run more than one server. Keep the bucket PRIVATE: the API
#     serves every file itself and checks who may see it.
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# --- Password reset by SMS -------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Never true in production (it returns reset codes to whoever asks).
ALLOW_DEV_CODE=false

# --- Other -----------------------------------------------------------------------------------
# A classic GitHub token with no scopes: exact contribution totals and a higher rate limit.
GITHUB_TOKEN=
# A cached contribution total older than this is refreshed when a profile is viewed.
GITHUB_REFRESH_HOURS=24
# Never true in production.
DEMO_LOGIN=false
# The first admin, created at start if missing. Prefer `python -m app.admin_cli create` and leave
# ADMIN_PASSWORD empty (an admin's password lives in the database, not here).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Site admin
REPORTS_PER_DAY=10
# Sign-in/sign-up/reset limits (defaults shown in .env.example) can be tuned here too.
